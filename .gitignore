# Public build-time API base URL (VITE_* vars are baked into the client bundle
# and are never secret); committed so Vercel builds wire to the backend.
!frontend/.env.production
frontend/coverage/
frontend/.cache/
frontend/.turbo/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Licensed Unity/WebGL landing export. This is intentionally deployable
# frontend runtime content, not a generated application build directory.
!frontend/public/Build/
!frontend/public/Build/**

# Logs and runtime output
*.log
*.out
*.pid
logs/
.logs/
backend/runtime/logs/*
runtime/logs/*
