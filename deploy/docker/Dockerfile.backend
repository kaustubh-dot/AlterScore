# ==============================================================================
# STAGE 1: BUILD ENVIRONMENT (DEPENDENCIES)
# ==============================================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Install system utilities needed for building wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies in a virtual environment
COPY backend/requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ==============================================================================
# STAGE 2: RUNTIME CONTEXT (PRODUCTION IMAGE)
# ==============================================================================
FROM python:3.12-slim AS runner

WORKDIR /app

# Create a non-privileged system user for runtime isolation
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/sh -m appuser

# Copy virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app:$PYTHONPATH"

# Setup runtime environment variables
ENV ALTERSCORE_ENV=production \
    ALTERSCORE_API_VERSION=0.2.0 \
    ALTERSCORE_REPO_ROOT=/app \
    ALTERSCORE_MODEL_MANIFEST=models/registry/production_manifest.json \
    ALTERSCORE_REQUEST_LOG_PATH=runtime/logs/requests.jsonl \
    ALTERSCORE_LOG_LEVEL=INFO \
    ALTERSCORE_CORS_ORIGINS="http://localhost,http://127.0.0.1"

# Copy source directories and artifacts
COPY backend /app/backend
COPY models /app/models
COPY scripts /app/scripts

# Preflight: create logging and runtime directory structures and set ownership
RUN mkdir -p /app/runtime/logs && \
    chown -R appuser:appgroup /app

USER appuser

# Expose FastAPI default port
EXPOSE 8000

# Healthcheck to verify service stability
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

# Execute uvicorn production server
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
