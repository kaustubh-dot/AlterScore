# ==============================================================================
# STAGE 1: BUILD ENVIRONMENT (VITE COMPILATION)
# ==============================================================================
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependency configs
COPY frontend/package.json frontend/package-lock.json ./

# Install packages
RUN npm ci

# Copy full frontend directory
COPY frontend/ .

# Inject production API endpoint base (use proxy routing)
ENV VITE_API_BASE_URL=/api

# Compile production-ready assets
RUN npm run build

# ==============================================================================
# STAGE 2: PRODUCTION SERVER (NGINX)
# ==============================================================================
FROM nginx:alpine-slim

# Copy compiled SPA assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Replace standard default Nginx configuration with optimized version
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Basic server healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
