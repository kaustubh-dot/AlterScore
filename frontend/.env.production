# Production build configuration (loaded by Vite during `vite build`).
# VITE_* values are public — they are inlined into the client bundle.
# Points the deployed SPA at the Hugging Face Spaces backend.
VITE_API_BASE_URL=https://coolbot22-alterscore-backend.hf.space/api
# Vercel must provide the exact 40-character VITE_RELEASE_SHA for each
# reviewed release build; the release gate rejects missing or local values.
