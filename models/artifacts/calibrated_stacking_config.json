{
  "model_name": "calibrated_stacking",
  "model_type": "ensemble",
  "base_model_order": [
    "logistic_regression",
    "random_forest",
    "xgboost",
    "lightgbm",
    "tabnet",
    "residual_mlp"
  ],
  "meta_learner": {
    "class": "LogisticRegression",
    "C": 1.0,
    "max_iter": 1000,
    "solver": "lbfgs"
  },
  "calibration": {
    "method": "isotonic",
    "cv": "prefit"
  },
  "tabnet_mitigation": {
    "enabled": true,
    "min_peer_confidence": 0.8,
    "disagreement_threshold": 0.25,
    "max_blend_weight": 0.75
  },
  "random_state": 42
}
