# Copy this file to .env for local development. Do not commit real secrets.

ALTERSCORE_ENV=local
ALTERSCORE_API_VERSION=0.2.0
ALTERSCORE_RELEASE_SHA=local
ALTERSCORE_SIGNING_SECRET=
ALTERSCORE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production the backend (Dockerfile) pins this to the deployed frontend
# origin, e.g. ALTERSCORE_CORS_ORIGINS=https://alterscore.vercel.app
# Optional regex (fullmatched) to additionally allow ephemeral preview hosts,
# e.g. ALTERSCORE_CORS_ORIGIN_REGEX=https://alterscore-[a-z0-9-]+\.vercel\.app

# Use an HTTPS development proxy or local TLS endpoint; the frontend rejects
# bearer-token transport over plain HTTP.
VITE_API_BASE_URL=https://127.0.0.1:8000/api
# In production the frontend reads this from frontend/.env.production, e.g.
# VITE_API_BASE_URL=https://coolbot22-alterscore-backend.hf.space/api
